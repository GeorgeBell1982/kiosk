# Template: adjust office_kiosk if the checkout has another name.
# Prefer desktop autostart on desktops that do not activate graphical-session.target.
[Unit]
Description=Office Kiosk Browser
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/office_kiosk
ExecStart=/bin/bash "%h/office_kiosk/scripts/start_kiosk.sh" --fullscreen
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
